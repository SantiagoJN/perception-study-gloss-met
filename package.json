{
  "name": "perception-study-gloss-met",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write_route_pages.mjs",
    "preview": "vite preview",
    "lint": "oxlint src",
    "test:e2e": "python3 tests/e2e_study.py",
    "test:e2e:routes": "python3 tests/e2e_direct_routes.py",
    "test:assets": "python3 tests/validate_study_assets.py && python3 tests/validate_deployment_config.py && python3 tests/validate_anonymous_access.py",
    "test:assets:ci": "python3 tests/validate_study_assets.py --skip-local-assets && python3 tests/validate_deployment_config.py && python3 tests/validate_anonymous_access.py",
    "test:deployment": "python3 tests/validate_sanitized_deployment.py --root dist",
    "test:worker": "npm --prefix cloudflare-worker test",
    "sanitize:deployment": "python3 scripts/sanitize_public_study_artifacts.py --root dist",
    "prepare:cloudflare-manifests": "python3 scripts/anonymize_cloudflare_manifests.py"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxlint": "1.76.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
